<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>SafeMe.Uninstaller.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SafeMe.Uninstaller</AssemblyName>
    <RootNamespace>SafeMe.Uninstaller</RootNamespace>
    <ApplicationIcon>../../assets/safeme.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>he-IL</NeutralLanguage>

    <!--
      פרטי הקובץ.

      בלי חתימה, זה מה שמוצג בתיבת ההרשאות ובמאפייני הקובץ. הוא
      אינו מבטל את אזהרת SmartScreen — רק תעודת EV עושה זאת — אבל
      הוא ההבדל בין קובץ אנונימי לתוכנה עם שם ויעד ברורים.
    -->
    <Company>SafeMe</Company>
    <Product>SafeMe</Product>
    <AssemblyTitle>SafeMe Uninstall</AssemblyTitle>
    <Description>הסרת SafeMe</Description>
    <Copyright>SafeMe</Copyright>
    <Version>1.1.59</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SafeMe.Core\SafeMe.Core.csproj" />
  </ItemGroup>
</Project>
