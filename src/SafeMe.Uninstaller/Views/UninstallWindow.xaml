<Window x:Class="SafeMe.Uninstaller.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeMe — הסרת התוכנה"
        Height="620" Width="520"
        MinHeight="560" MinWidth="480"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI, Arial"
        ResizeMode="CanMinimize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- כותרת -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="הסרת SafeMe" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                       Text="הסרת התוכנה מחייבת קוד חד-פעמי מהמוקד. מסרו לנציג את קוד הזיהוי שמופיע למטה, וקבלו בחזרה קוד הסרה." />
        </StackPanel>

        <!-- שלב 1: קוד זיהוי -->
        <Border Grid.Row="1" Margin="0,16,0,0" Background="{StaticResource BgPanel}"
                CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" FontSize="14" Text="שלב 1 — קוד הזיהוי" />

                <Border Margin="0,10,0,0" Background="{StaticResource BgSubtle}"
                        CornerRadius="6" Padding="12">
                    <TextBox x:Name="ChallengeBox"
                             FlowDirection="LeftToRight"
                             IsReadOnly="True"
                             Background="Transparent"
                             FontFamily="Consolas, Courier New"
                             FontSize="15"
                             TextWrapping="Wrap"
                             Text="—" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="GenerateButton" Content="הצג קוד זיהוי" Click="OnGenerateClick" />
                    <Button x:Name="CopyButton" Content="העתק" Margin="8,0,0,0"
                            Click="OnCopyClick" IsEnabled="False" />
                    <TextBlock x:Name="ExpiryText" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Text="" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- שלב 2: קוד הסרה -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource BgPanel}"
                CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" FontSize="14" Text="שלב 2 — קוד ההסרה מהמוקד" />

                <!--
                    גובה קבוע, ולא MinHeight.

                    קוד ההסרה הוא חתימת RSA בבסיס 64 — כשש מאות תווים.
                    עם MinHeight השדה גדל לפי התוכן, דחף את הכפתורים
                    מתחת לקצה החלון, ומי שהדביק את הקוד לא יכול היה
                    ללחוץ "אמת והסר". נצפה בשטח.

                    ResizeMode="CanMinimize" מונע מהמשתמש להגדיל את
                    החלון ולעקוף את זה, ולכן הגובה חייב להיות חסום
                    כאן ולא להיות תלוי בתוכן.
                -->
                <TextBox x:Name="ResponseBox"
                         Margin="0,10,0,0"
                         FlowDirection="LeftToRight"
                         FontFamily="Consolas, Courier New"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="88"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="OnResponseChanged" />

                <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" Margin="0,8,0,0"
                           Text="הקוד יתקבל מנציג המוקד לאחר אימות זהות." />
            </StackPanel>
        </Border>

        <!-- הודעת מצב -->
        <Border x:Name="MessageBorder" Grid.Row="3" Margin="0,12,0,0"
                Background="{StaticResource BgPanel}" CornerRadius="10"
                Padding="14" Visibility="Collapsed">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource Fg}" />
        </Border>

        <!-- מידע -->
        <Border Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Bottom"
                Background="{StaticResource BgPanel}" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}"
                           Text="לאחר שלושה קודים שגויים המסך יינעל ל-15 דקות. הנעילה אינה מתקצרת בשינוי שעון המערכת." />
                <TextBlock x:Name="AttemptsText" Style="{StaticResource Muted}" Margin="0,6,0,0" Text="" />
            </StackPanel>
        </Border>

        <!-- פעולות -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="VerifyButton" Content="אמת והסר" Click="OnVerifyClick"
                    IsEnabled="False" Background="{StaticResource Accent}" />
            <Button Content="ביטול" Margin="8,0,0,0" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
