{
  "manifest_version": 3,
  "name": "SafeMe Audio",
  "version": "1.0.0",
  "description": "YouTube audio-only mode, managed by SafeMe.",

  "permissions": [
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "*://*.youtube.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_video",
        "enabled": true,
        "path": "rules/block-video.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["scripts/youtube-audio-only.js"],
      "css": ["styles/youtube-audio-only.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "scripts/background.js"
  },

  "minimum_chrome_version": "111"
}
