{
  "manifest_version": 3,
  "name": "SafeMe Guard",
  "version": "1.1.0",
  "description": "YouTube audio-only mode, thumbnail hiding, and AI image filtering, managed by SafeMe.",

  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://*.claude.ai/*",
    "*://*.copilot.microsoft.com/*",
    "*://*.gemini.google.com/*",
    "*://*.perplexity.ai/*",
    "*://*.deepseek.com/*",
    "*://*.mistral.ai/*",
    "*://chat.mistral.ai/*",
    "*://*.poe.com/*",
    "*://*.you.com/*",
    "*://*.grok.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_video",
        "enabled": true,
        "path": "rules/block-video.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["scripts/youtube-audio-only.js"],
      "css": ["styles/youtube-audio-only.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://*.claude.ai/*",
        "*://*.copilot.microsoft.com/*",
        "*://*.gemini.google.com/*",
        "*://*.perplexity.ai/*",
        "*://*.deepseek.com/*",
        "*://*.mistral.ai/*",
        "*://chat.mistral.ai/*",
        "*://*.poe.com/*",
        "*://*.you.com/*",
        "*://*.grok.com/*"
      ],
      "js": ["scripts/ai-safe-mode.js"],
      "css": ["styles/ai-safe-mode.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "scripts/background.js"
  },

  "storage": {
    "managed_schema": "managed_schema.json"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "111"
}
