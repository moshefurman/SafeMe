{
  "manifest_version": 3,
  "name": "SafeMe YouTube Guard",
  "version": "1.0.0",
  "description": "YouTube audio-only mode and thumbnail hiding, managed by SafeMe.",

  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],

  "host_permissions": [
    "*://*.youtube.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_video",
        "enabled": true,
        "path": "rules/block-video.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["scripts/youtube-audio-only.js"],
      "css": ["styles/youtube-audio-only.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "scripts/background.js"
  },

  "storage": {
    "managed_schema": "managed_schema.json"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "111"
}
