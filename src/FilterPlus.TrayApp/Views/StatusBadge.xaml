<Window x:Class="FilterPlus.TrayApp.Views.StatusBadge"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FilterPlus"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- שוליים לצל. בלעדיהם הצל נחתך בקצה החלון. -->
    <Grid Margin="14">
        <Border x:Name="Pill"
                CornerRadius="21"
                Padding="9,6,14,6"
                Background="#F0161C24"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                  Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- המגן. אותה צורה בדיוק כמו אייקון התוכנה ואייקון המגש. -->
                <Image x:Name="ShieldImage" Width="28" Height="28"
                       VerticalAlignment="Center" />

                <StackPanel x:Name="TextPanel" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="בודק..."
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#FFF1F5FA"
                               LineHeight="16"
                               TextOptions.TextFormattingMode="Ideal" />

                    <TextBlock x:Name="DetailText"
                               Text="FilterPlus"
                               FontSize="10.5"
                               Foreground="#FF93A1B3"
                               LineHeight="13"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <Window.ContextMenu>
        <ContextMenu FlowDirection="RightToLeft">
            <MenuItem Header="הצג פרטים" Click="OnShowDetails" />
            <MenuItem Header="בדוק עכשיו" Click="OnRunAudit" />
            <MenuItem Header="רענן מהשרת" Click="OnRefreshFromServer" />
            <Separator />
            <MenuItem x:Name="CollapseItem" Header="כווץ" Click="OnToggleCollapse" />
            <MenuItem Header="העבר לפינה הנגדית" Click="OnFlipSide" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
