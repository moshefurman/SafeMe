<Application x:Class="SafeMe.TrayApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- לוח צבעים אחיד לכל מסכי SafeMe -->
        <SolidColorBrush x:Key="Bg"          Color="#FF12161C" />
        <SolidColorBrush x:Key="BgPanel"     Color="#FF1A1F27" />
        <SolidColorBrush x:Key="BgSubtle"    Color="#FF232A34" />
        <SolidColorBrush x:Key="Fg"          Color="#FFEDF1F7" />
        <SolidColorBrush x:Key="FgMuted"     Color="#FF95A1B2" />
        <SolidColorBrush x:Key="Accent"      Color="#FF3B82F6" />
        <SolidColorBrush x:Key="StatusSafe"  Color="#FF22C55E" />
        <SolidColorBrush x:Key="StatusLow"   Color="#FFF59E0B" />
        <SolidColorBrush x:Key="StatusBad"   Color="#FFEF4444" />
        <SolidColorBrush x:Key="StatusGray"  Color="#FF6B7280" />
        <SolidColorBrush x:Key="StatusList"  Color="#FF9A86E0" />

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSubtle}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF313A47" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
