<Window x:Class="SafeMe.TrayApp.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeMe — מצב החיבור"
        Height="580" Width="460"
        MinHeight="480" MinWidth="420"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI, Arial"
        ResizeMode="CanResize">

    <!--
        התוכן כולו בגלילה אחת, והכפתורים מחוצה לה.

        קודם כל פאנל קיבל שורה משלו, ורק האחרון היה גמיש. ברגע
        שפאנל הפרטים גדל בשלוש שורות הוא דחס את זה שמתחתיו לאפס,
        והכיתוב "בדיקות שנכשלו" נחתך באמצע. פריסה שתלויה בכך שהתוכן
        לא יגדל תישבר שוב בפעם הבאה שמישהו יוסיף שורה.

        הכפתורים נשארים מחוץ לגלילה במכוון: "בדוק עכשיו" ו"סגור"
        צריכים להיות במקום קבוע ולא להיעלם למטה.
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel>

        <!-- כותרת ומחוון מצב -->
        <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="14" Height="14"
                             VerticalAlignment="Center" Fill="{StaticResource StatusGray}" />
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource H1}"
                               Margin="10,0,0,0" Text="בודק…" />
                </StackPanel>

                <TextBlock x:Name="Headline" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Fg}" FontSize="13"
                           Text="מתחבר ל-SafeMe…" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Text="ציון סינון" />

                    <!--
                        המילוי הוא עמודה יחסית ולא רוחב מחושב.

                        קודם הרוחב נגזר מ-ActualWidth של החלון פחות מספר
                        קבוע שאמור היה לייצג את התווית והשוליים. הוא לא
                        ייצג אותם, ולכן ציון 100 מילא כשלושה רבעים מהפס
                        — והפער גדל בכל הגדלה של החלון.

                        עמודות כוכב נמדדות מול המסלול עצמו, ולכן 100
                        הוא תמיד הפס כולו, בכל רוחב.
                    -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Border Height="8" CornerRadius="4" Background="{StaticResource BgSubtle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ScoreFilled" Width="0*" />
                                <ColumnDefinition x:Name="ScoreEmpty" Width="100*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ScoreBar" Grid.Column="0"
                                    Height="8" CornerRadius="4"
                                    Background="{StaticResource StatusGray}" />
                        </Grid>
                    </Grid>
                </Grid>

                <TextBlock x:Name="ScoreText" Style="{StaticResource Muted}"
                           Margin="0,6,0,0" Text="—" />
            </StackPanel>
        </Border>

        <!-- פרטי חיבור -->
        <Border Margin="0,12,0,0"
                Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16">
            <StackPanel x:Name="DetailsPanel" />
        </Border>

        <!-- בדיקות שנכשלו -->
        <Border Margin="0,12,0,0"
                Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}"
                           FontSize="14" Text="בדיקות שנכשלו" Margin="0,0,0,10" />

                <TextBlock x:Name="NoFailures" DockPanel.Dock="Top"
                           Style="{StaticResource Muted}" Visibility="Collapsed"
                           Text="כל הבדיקות עברו." />

                <ItemsControl x:Name="FailureList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSubtle}" CornerRadius="6"
                                        Padding="10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#FFEDF1F7"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#FF95A1B2"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- פעולות. מחוץ לגלילה, כדי שלא ייעלמו למטה. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="AuditButton" Content="בדוק עכשיו" Click="OnAuditClick" />
            <Button Content="סגור" Margin="8,0,0,0" Click="OnCloseClick" />

            <TextBlock x:Name="FooterText" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Text="" />
        </StackPanel>
    </Grid>
</Window>
