<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SafeMe.TrayApp</AssemblyName>
    <RootNamespace>SafeMe.TrayApp</RootNamespace>
    <ApplicationIcon>../../assets/safeme.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NeutralLanguage>he-IL</NeutralLanguage>

    <!--
      פרטי הקובץ.

      בלי חתימה, זה מה שמוצג בתיבת ההרשאות ובמאפייני הקובץ. הוא
      אינו מבטל את אזהרת SmartScreen — רק תעודת EV עושה זאת — אבל
      הוא ההבדל בין קובץ אנונימי לתוכנה עם שם ויעד ברורים.
    -->
    <Company>SafeMe</Company>
    <Product>SafeMe</Product>
    <AssemblyTitle>SafeMe</AssemblyTitle>
    <Description>תג מצב ההגנה של SafeMe</Description>
    <Copyright>SafeMe</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SafeMe.Core\SafeMe.Core.csproj" />
  </ItemGroup>
</Project>
