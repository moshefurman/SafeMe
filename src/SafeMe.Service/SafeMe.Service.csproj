<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>SafeMe.Service</AssemblyName>
    <RootNamespace>SafeMe.Service</RootNamespace>
    <UserSecretsId>safeme-service</UserSecretsId>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../../assets/safeme.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.1.59</Version>

    <!--
      פרטי הקובץ.

      בלי חתימה, זה מה שמוצג בתיבת ההרשאות ובמאפייני הקובץ. הוא
      אינו מבטל את אזהרת SmartScreen — רק תעודת EV עושה זאת — אבל
      הוא ההבדל בין קובץ אנונימי לתוכנה עם שם ויעד ברורים.
    -->
    <Company>SafeMe</Company>
    <Product>SafeMe</Product>
    <AssemblyTitle>SafeMe Agent</AssemblyTitle>
    <Description>שירות SafeMe — אכיפת חיבור אינטרנט מסונן</Description>
    <Copyright>SafeMe</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SafeMe.Core\SafeMe.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
