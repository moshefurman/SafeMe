<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>FilterPlus.Uninstaller.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FilterPlus.Uninstaller</AssemblyName>
    <RootNamespace>FilterPlus.Uninstaller</RootNamespace>
    <ApplicationIcon>../../assets/filterplus.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>he-IL</NeutralLanguage>

    <!--
      פרטי הקובץ.

      בלי חתימה, זה מה שמוצג בתיבת ההרשאות ובמאפייני הקובץ. הוא
      אינו מבטל את אזהרת SmartScreen — רק תעודת EV עושה זאת — אבל
      הוא ההבדל בין קובץ אנונימי לתוכנה עם שם ויעד ברורים.
    -->
    <Company>FilterPlus</Company>
    <Product>FilterPlus</Product>
    <AssemblyTitle>FilterPlus Uninstall</AssemblyTitle>
    <Description>הסרת FilterPlus</Description>
    <Copyright>FilterPlus</Copyright>
    <Version>1.1.60</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FilterPlus.Core\FilterPlus.Core.csproj" />
  </ItemGroup>
</Project>
