<Application x:Class="SafeMe.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!--
          אותה פלטה של מסיר ההתקנה ושל תג המצב.

          המשתמש רואה את שלושתם, ומתקין שנראה כמו תוכנה אחרת הוא
          בדיוק מה שמלמד לא לסמוך על מה שמופיע על המסך.
        -->
        <SolidColorBrush x:Key="Bg"       Color="#FF12161C" />
        <SolidColorBrush x:Key="BgPanel"  Color="#FF1A1F27" />
        <SolidColorBrush x:Key="BgSubtle" Color="#FF232A34" />
        <SolidColorBrush x:Key="Fg"       Color="#FFEDF1F7" />
        <SolidColorBrush x:Key="FgMuted"  Color="#FF95A1B2" />
        <SolidColorBrush x:Key="Accent"   Color="#FF3B82F6" />
        <SolidColorBrush x:Key="Danger"   Color="#FFEF4444" />
        <SolidColorBrush x:Key="Success"  Color="#FF22C55E" />
        <SolidColorBrush x:Key="Warn"     Color="#FFF59E0B" />

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSubtle}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF313A47" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- הכפתור הראשי. אחד בלבד בכל מסך. -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="34,13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF5A98F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- פס ההתקדמות. דק, בלי מסגרת, בצבע המותג. -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="{StaticResource BgSubtle}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

    </Application.Resources>
</Application>
