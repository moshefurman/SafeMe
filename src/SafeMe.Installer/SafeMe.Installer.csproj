<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SafeMe-Setup</AssemblyName>
    <RootNamespace>SafeMe.Installer</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../../assets/safeme.ico</ApplicationIcon>

    <!--
      המתקין עצמו עצמאי, ובמכוון.

      הוא זה שבודק אם סביבת ההרצה מותקנת ומתקין אותה אם לא — ולכן
      הוא לא יכול להיות תלוי בה. הסוכן שהוא פורס כן תלוי, וזה מה
      שמשאיר את העדכונים בגודל של מגה וקצת.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    המטען נוצר בשלב האריזה ולא נשמר במאגר.

    התנאי מאפשר ל-dotnet build של הפתרון כולו להצליח גם בלעדיו,
    ואז המתקין נבנה אך מסרב לרוץ בהודעה ברורה. עדיף על שבירת הבנייה
    לכל מי שרק רוצה להריץ בדיקות.
  -->
  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeMe.Core\SafeMe.Core.csproj" />
  </ItemGroup>
</Project>
