<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!--
      WinExe ולא Exe.

      זה מה שמונע את חלון המסוף השחור. במצב quiet הקובץ מתחבר
      למסוף של מי שהריץ אותו, ולכן הפריסה המרוכזת עדיין רואה פלט.
    -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SafeMe-Setup</AssemblyName>
    <RootNamespace>SafeMe.Installer</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../../assets/safeme.ico</ApplicationIcon>

    <!--
      המתקין עצמו עצמאי, ובמכוון.

      הוא זה שבודק אם סביבת ההרצה מותקנת ומתקין אותה אם לא — ולכן
      הוא לא יכול להיות תלוי בה. הסוכן שהוא פורס כן תלוי, וזה מה
      שמשאיר את העדכונים בגודל של מגה וקצת.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      פרטי הקובץ.

      בלי חתימה, זה מה שמוצג בתיבת ההרשאות ובמאפייני הקובץ. הוא
      אינו מבטל את אזהרת SmartScreen — רק תעודת EV עושה זאת — אבל
      הוא ההבדל בין קובץ אנונימי לתוכנה עם שם ויעד ברורים.
    -->
    <Company>SafeMe</Company>
    <Product>SafeMe</Product>
    <AssemblyTitle>SafeMe Setup</AssemblyTitle>
    <Description>מתקין SafeMe — אכיפת חיבור אינטרנט מסונן</Description>
    <Copyright>SafeMe</Copyright>
  </PropertyGroup>

  <!--
    המטען נוצר בשלב האריזה ולא נשמר במאגר.

    התנאי מאפשר ל-dotnet build של הפתרון כולו להצליח גם בלעדיו,
    ואז המתקין נבנה אך מסרב לרוץ בהודעה ברורה. עדיף על שבירת הבנייה
    לכל מי שרק רוצה להריץ בדיקות.
  -->
  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <!--
    App.xaml נרשם כ-Page ולא כ-ApplicationDefinition.

    ApplicationDefinition היה מייצר Main משלו, ואז אין דרך להחליט
    בין החלון למצב השקט לפני שהיישום הגרפי כבר עלה.
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeMe.Core\SafeMe.Core.csproj" />
  </ItemGroup>
  <!--
    UseWPF מחליף את סט ה-usings המרומזים ומשמיט את System.IO
    ו-System.Net.Http. מוחזרים כאן במפורש, במקום בכל קובץ בנפרד.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
