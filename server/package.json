{
  "name": "safeme-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate.ts --status",
    "build": "tsc -p tsconfig.json",
    "check:sql": "node scripts/check-sql.ts",
    "check": "npm run typecheck && npm run check:sql && npm run check:vectors",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:reset": "npm run db:down && npm run db:up && npm run migrate && npm run db:init",
    "db:init": "docker exec safeme-poc psql -U postgres -d safeme -q -c \"ALTER ROLE safeme_app WITH PASSWORD 'poc_app_only';\"",
    "poc": "npm run poc:db && npm run poc:api && npm run poc:auth && npm run poc:portal && npm run poc:trial && npm run poc:sampling && npm run poc:kms && npm run poc:keys && npm run poc:updates && npm run poc:download",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "poc:db": "node --env-file-if-exists=.env scripts/poc.ts",
    "poc:api": "node --env-file-if-exists=.env scripts/poc-api.ts",
    "check:vectors": "node scripts/check-vectors.ts",
    "poc:auth": "node --env-file-if-exists=.env scripts/poc-auth.ts",
    "poc:portal": "node --env-file-if-exists=.env scripts/poc-portal.ts",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "poc:trial": "node --env-file-if-exists=.env scripts/poc-trial.ts",
    "poc:sampling": "node scripts/poc-sampling.ts",
    "poc:kms": "node scripts/poc-kms.ts",
    "poc:keys": "node --env-file-if-exists=.env scripts/poc-keys.ts",
    "db:app-password": "node --env-file-if-exists=.env scripts/set-app-password.ts",
    "poc:updates": "node --env-file-if-exists=.env scripts/poc-updates.ts",
    "poc:download": "node --env-file-if-exists=.env scripts/poc-download.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1118.0",
    "@google-cloud/kms": "^6.0.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.12.1",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
