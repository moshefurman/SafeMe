# ── פיתוח מקומי (docker compose up -d) ──────────────────────────
# מריץ מיגרציות. משתמש בעל הרשאות מלאות.
DATABASE_URL=postgres://postgres:poc_local_only@localhost:55432/safeme

# משתמש האפליקציה. עליו נאכף RLS. לעולם לא להריץ איתו מיגרציות,
# ולעולם לא להחליף אותו במשתמש בעל הסכמה - זה מבטל את בידוד הדיירים.
DATABASE_URL_APP=postgres://safeme_app:poc_app_only@localhost:55432/safeme

NODE_ENV=development
